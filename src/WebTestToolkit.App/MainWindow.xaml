<Window x:Class="WebTestToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebTestToolkit.App"
        mc:Ignorable="d"
        Title="Web Test Toolkit" Height="600" Width="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="RunSampleTestButton"
                    Content="Run Sample Test"
                    Padding="12,6"
                    Click="RunSampleTestButton_Click"/>
            <TextBlock x:Name="StatusText"
                       Text="Idle"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </StackPanel>

        <TextBox x:Name="OutputTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Background="#1E1E1E"
                 Foreground="#D4D4D4"/>
    </Grid>
</Window>
